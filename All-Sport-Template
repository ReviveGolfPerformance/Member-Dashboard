<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dynamic Athlete Performance Dashboard</title>
  <style>
    /* --- CSS VARIABLES & THEMING --- */
    :root {
      --bg-dark: #0f1115;
      --bg-card: #161920;
      --border-color: #262b36;
      --text-main: #ffffff;
      --text-muted: #94a3b8;
      
      /* Status Colors */
      --status-optimal: #10b981;
      --status-monitor: #f59e0b;
      --status-restricted: #ef4444;
      
      /* Dynamic Brand Color (Overridden by JS) */
      --sport-color: #cc1010; 
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      padding: 2rem 1rem;
      line-height: 1.5;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    /* --- SPORT SELECTOR CONTROLS --- */
    .controls-panel {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2rem;
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      align-items: center;
      justify-content: space-between;
    }

    .selector-group {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    label {
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      font-weight: 600;
    }

    select {
      background: var(--bg-dark);
      color: var(--text-main);
      border: 1px solid var(--sport-color);
      padding: 0.6rem 1.5rem;
      border-radius: 6px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      outline: none;
      transition: border-color 0.3s;
    }

    /* --- HEADER APP --- */
    header {
      margin-bottom: 2.5rem;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 1.5rem;
    }

    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .brand-title {
      font-size: 1.8rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .brand-accent {
      color: var(--sport-color);
      transition: color 0.3s;
    }

    .athlete-meta {
      margin-top: 0.5rem;
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    /* --- GRID LAYOUTS --- */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      margin-bottom: 2rem;
    }

    @media (min-width: 900px) {
      .dashboard-grid {
        grid-template-columns: 1.2fr 0.8fr;
      }
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 1.5rem;
      height: 100%;
    }

    .card-title {
      font-size: 1.2rem;
      font-weight: 700;
      margin-bottom: 1.2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* --- CAPACITY SCREEN LIST --- */
    .screen-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .screen-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 1rem;
      background: var(--bg-dark);
      border-left: 4px solid var(--border-color);
      border-radius: 4px;
    }

    .screen-item.optimal { border-left-color: var(--status-optimal); }
    .screen-item.monitor { border-left-color: var(--status-monitor); }
    .screen-item.restricted { border-left-color: var(--status-restricted); }

    .screen-name {
      font-weight: 500;
    }

    .screen-value {
      font-weight: 700;
      padding: 0.2rem 0.6rem;
      border-radius: 4px;
      background: rgba(255,255,255,0.05);
    }

    /* --- LOAD MANAGEMENT TRACKER --- */
    .load-container {
      margin-top: 1rem;
    }

    .load-bar-bg {
      background: var(--bg-dark);
      height: 24px;
      border-radius: 12px;
      position: relative;
      margin: 1.5rem 0;
      overflow: hidden;
      border: 1px solid var(--border-color);
    }

    .load-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--sport-color), #ff6b6b);
      width: 0%;
      transition: width 0.8s ease-in-out, background 0.3s;
    }

    .load-markers {
      display: flex;
      justify-content: space-between;
      color: var(--text-muted);
      font-size: 0.8rem;
      font-weight: 600;
    }

    /* --- PERFORMANCE OUTPUTS --- */
    .perf-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    @media (min-width: 600px) {
      .perf-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .perf-category {
      background: var(--bg-dark);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 1.2rem;
    }

    .category-title {
      color: var(--sport-color);
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 1rem;
      font-weight: 700;
      transition: color 0.3s;
    }

    .metric-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 0;
      border-bottom: 1px dashed rgba(255,255,255,0.05);
    }

    .metric-row:last-child {
      border-bottom: none;
    }

    .metric-label {
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    .metric-values {
      text-align: right;
    }

    .val-pre {
      font-size: 0.8rem;
      color: var(--text-muted);
      text-decoration: line-through;
      margin-right: 0.4rem;
    }

    .val-post {
      font-weight: 700;
      color: var(--text-main);
    }

    /* --- ACTION CALLOUT --- */
    .action-box {
      background: linear-gradient(135deg, var(--bg-card) 0%, rgba(22,25,32,0.7) 100%);
      border: 1px solid var(--sport-color);
      border-radius: 12px;
      padding: 1.5rem;
      margin-top: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      justify-content: space-between;
      align-items: flex-start;
      transition: border-color 0.3s;
    }

    @media (min-width: 768px) {
      .action-box {
        flex-direction: row;
        align-items: center;
      }
    }

    .cta-btn {
      background: var(--sport-color);
      color: #fff;
      border: none;
      padding: 0.8rem 1.8rem;
      border-radius: 6px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      white-space: nowrap;
      transition: opacity 0.2s;
    }

    .cta-btn:hover {
      opacity: 0.9;
    }
  </style>
</head>
<body>

  <div class="container">

    <!-- CONTROLS PANEL -->
    <div class="controls-panel">
      <div class="selector-group">
        <label for="sportSelect">Select Athlete Profile:</label>
        <select id="sportSelect" onchange="switchSportProfile(this.value)">
          <option value="baseball">Baseball Player (Alex Rodriguez)</option>
          <option value="basketball">Basketball Player (Jordan Smith)</option>
          <option value="soccer">Soccer Player (Marcus Rashford)</option>
          <option value="dance">Contemporary Dancer (Elena Rostova)</option>
        </select>
      </div>
      <div style="font-size: 0.85rem; color: var(--text-muted);">
        Status Date: <span id="currentDate">June 2026</span>
      </div>
    </div>

    <!-- MAIN TEMPLATE HEADER -->
    <header>
      <div class="header-top">
        <div>
          <div class="brand-title">REVIVE <span id="dynamicBrand" class="brand-accent">ATHLETIC RUNTIME</span></div>
          <div id="athleteMeta" class="athlete-meta">Loading Profile...</div>
        </div>
      </div>
    </header>

    <!-- TWO COLUMN METRIC SPLIT -->
    <div class="dashboard-grid">
      
      <!-- LEFT COLUMN: PHYSICAL SCREEN & BIO-CAPACITIES -->
      <div class="card">
        <div class="card-title">
          <span>Physical Capacity Screening</span>
          <span style="font-size: 0.8rem; font-weight: normal; color: var(--text-muted);">Biomechanical Targets</span>
        </div>
        <div id="screenList" class="screen-list">
          <!-- Populated dynamically via JS -->
        </div>
      </div>

      <!-- RIGHT COLUMN: LOAD MANAGEMENT -->
      <div class="card">
        <div class="card-title">
          <span>Load Management & Readiness</span>
        </div>
        <p id="loadIntro" class="metric-label">Tracking structural load thresholds against current weekly capacity limits.</p>
        
        <div class="load-container">
          <div id="loadLabel" style="font-weight: 700; font-size: 0.9rem; margin-bottom: 0.25rem;">Volume Metric</div>
          <div class="load-bar-bg">
            <div id="loadBar" class="load-bar-fill"></div>
          </div>
          <div class="load-markers">
            <span>Optimal Baseline</span>
            <span>Warning Limit</span>
            <span>Overuse Risk</span>
          </div>
        </div>

        <div id="loadAlert" style="margin-top: 1.5rem; padding: 0.75rem; background: rgba(245, 158, 11, 0.1); border-left: 3px solid var(--status-monitor); font-size: 0.85rem; border-radius: 4px;">
          <!-- Dynamically inserted alerts -->
        </div>
      </div>

    </div>

    <!-- SPORT METRICS OUTPUT PANELS -->
    <div class="card">
      <div class="card-title">
        <span id="perfTitle">Sport-Specific Functional Output Metrics</span>
      </div>
      <div id="perfGrid" class="perf-grid">
        <!-- Populated dynamically via JS -->
      </div>
    </div>

    <!-- ACTION CALLOUT BUTTON -->
    <div class="action-box">
      <div>
        <h3 id="ctaHeading" style="margin-bottom: 0.25rem;">Schedule Load Adjustments</h3>
        <p id="ctaDesc" class="metric-label">Access your custom motor adjustments and movement prehab strategies.</p>
      </div>
      <button class="cta-btn" id="ctaBtn">Book Performance Session</button>
    </div>

  </div>

  <!-- --- SPORT SPECIFIC DATA COMPILATION & CONFIGURATION --- -->
  <script>
    const SPORT_PROFILES = {
      baseball: {
        brandName: "BASEBALL PERFORMANCE",
        themeColor: "#FF5722", // High vis blazing orange
        athleteName: "Alex Rodriguez",
        position: "Pitcher / Third Base",
        screens: [
          { name: "Shoulder Internal Rotation (GIRD Screen)", value: "38°", status: "monitor" },
          { name: "Thoracic Rotation Velocity Index", value: "52°/s", status: "optimal" },
          { name: "Lead Hip Internal Rotation", value: "28°", status: "restricted" },
          { name: "Scapular Upward Rotation Control", value: "Pass", status: "optimal" }
        ],
        loadManagement: {
          intro: "Tracking cumulative weekly pitch volumes and intensive high-velocity throwing sessions.",
          unitLabel: "Weekly Pitch Count / Throwing Volume",
          percentage: 82,
          alert: "Alert: High throwing volume window approaching acute structural fatigue cap."
        },
        performance: {
          title: "Pitching & Batting Kinetic Metrics",
          categories: [
            {
              name: "Ballistic Velocity Out",
              metrics: [
                { name: "Max Fastball Velocity", pre: "88 mph", post: "92 mph" },
                { name: "Exit Velocity (Off Tee)", pre: "94 mph", post: "99 mph" }
              ]
            },
            {
              name: "Rotational Force Delivery",
              metrics: [
                { name: "Med Ball Side Toss Power", pre: "18 mph", post: "22 mph" },
                { name: "Pelvic-to-Torso Kinematic Separation", pre: "32°", post: "38°" }
              ]
            }
          ]
        },
        cta: {
          title: "Prep for Arm Care Tracking",
          desc: "Access your individualized arm care pathway, rotator cuff mechanics, and recovery tools."
        }
      },
      basketball: {
        brandName: "HOOPS HOOP LAB",
        themeColor: "#3b82f6", // Court electrical blue
        athleteName: "Jordan Smith",
        position: "Point Guard / Shooting Guard",
        screens: [
          { name: "Ankle Dorsiflexion Range (Closed Chain)", value: "32°", status: "restricted" },
          { name: "Reactive Strength Index (RSI)", value: "2.4", status: "optimal" },
          { name: "Lateral Hip Abduction Stability", value: "Optimal", status: "optimal" },
          { name: "Knee Valgus On Landing Drop Test", value: "Slight Deficit", status: "monitor" }
        ],
        loadManagement: {
          intro: "Monitoring high-impact landing volumes, cumulative hardwood impact forces, and deceleration stressors.",
          unitLabel: "Weekly Jump Vol / Hardwood Accelerations",
          percentage: 65,
          alert: "Optimal: Structural landing parameters stable. No excessive load strain spikes noted."
        },
        performance: {
          title: "Vertical Force & Change-of-Direction Outputs",
          categories: [
            {
              name: "Vertical Transfer Mechanics",
              metrics: [
                { name: "Max Countermovement Jump", pre: "26.5 in", post: "30.2 in" },
                { name: "Approach Vertical Reach", pre: "10' 4\"", post: "10' 8\"" }
              ]
            },
            {
              name: "Court Agility Benchmarks",
              metrics: [
                { name: "Pro Agility Shuttle (5-10-5)", pre: "4.52 s", post: "4.31 s" },
                { name: "Lane Agility Drill Duration", pre: "11.8 s", post: "10.9 s" }
              ]
            }
          ]
        },
        cta: {
          title: "Review Landing Strategies",
          desc: "Targeted patellar tendon loading profiles and ankle mobility warm-up models inside."
        }
      },
      soccer: {
        brandName: "PITCH SOCCER LAB",
        themeColor: "#10b981", // Pitch turf green
        athleteName: "Marcus Rashford",
        position: "Winger / Striker",
        screens: [
          { name: "Adductor/Abductor Strength Ratio", value: "0.82", status: "monitor" },
          { name: "Hamstring Eccentric Force Break", value: "Optimal", status: "optimal" },
          { name: "Active Straight Leg Raise (ASLR)", value: "72°", status: "optimal" },
          { name: "First Ray Extension (Great Toe Extension)", value: "48°", status: "restricted" }
        ],
        loadManagement: {
          intro: "Evaluating global high-speed running distances, pitch volume overloads, and acceleration limits.",
          unitLabel: "Weekly GPS High Speed Sprint Distance",
          percentage: 91,
          alert: "Critical Zone: High Speed running volume exceeds baseline capacity by 15%. Rest advised."
        },
        performance: {
          title: "Field Speed & Aerobic Power Metrics",
          categories: [
            {
              name: "Linear Acceleration Splits",
              metrics: [
                { name: "10-Yard Fly Speed", pre: "1.45 s", post: "1.38 s" },
                { name: "40-Yard Sprint Threshold", pre: "4.72 s", post: "4.54 s" }
              ]
            },
            {
              name: "Field Strike Mechanics",
              metrics: [
                { name: "Max Ball Striking Velocity", pre: "68 mph", post: "74 mph" },
                { name: "Repeated Sprint Ability (RSA Decline)", pre: "6.2%", post: "4.1%" }
              ]
            }
          ]
        },
        cta: {
          title: "Access Groin/Hamstring Prehab",
          desc: "Unlock your prescribed Nordic hamstring progression protocols and dynamic hip mechanics."
        }
      },
      dance: {
        brandName: "KINETIC DANCE ARCHITECTURE",
        themeColor: "#a855f7", // Elegant deep studio violet
        athleteName: "Elena Rostova",
        position: "Principal Soloist (Contemporary/Ballet)",
        screens: [
          { name: "Hip External Rotation (Turnout Metric)", value: "58°", status: "optimal" },
          { name: "Posterior Chain Mobility Screen", value: "High Range", status: "optimal" },
          { name: "Plantarflexion End-Range Stability", value: "Hypermobile/Unstable", status: "restricted" },
          { name: "Core Extensions Trunk Endurance", value: "140 s", status: "monitor" }
        ],
        loadManagement: {
          intro: "Calculating weekly continuous rehearsal hours, impact landings from allegro routines, and foot strain arrays.",
          unitLabel: "Rehearsal Hours / Impact Floor Load",
          percentage: 75,
          alert: "Monitor: Plantar stabilization scores tracking lower due to floor stiffness changes."
        },
        performance: {
          title: "Artistic Power & End-Range Control Elements",
          categories: [
            {
              name: "Jump Power & Suspension",
              metrics: [
                { name: "Saut de Chat Dispersion Height", pre: "18.2 in", post: "21.5 in" },
                { name: "Force Peak on Impact Absorption", pre: "3.4 BW", post: "2.8 BW" }
              ]
            },
            {
              name: "End-Range Force Holds",
              metrics: [
                { name: "Arabesque Dynamic Hold Time", pre: "4.5 s", post: "8.2 s" },
                { name: "Single-Leg Balance Stability Index", pre: "Index 3.2", post: "Index 1.4" }
              ]
            }
          ]
        },
        cta: {
          title: "Access Studio Balance Prehab",
          desc: "Review foot core routines, intrinsic muscle tuning drills, and hip stabilization structures."
        }
      }
    };

    function switchSportProfile(sportId) {
      const data = SPORT_PROFILES[sportId];
      if (!data) return;

      // 1. Update Sport CSS Color Accent Theme
      document.documentElement.style.setProperty('--sport-color', data.themeColor);

      // 2. Base Brand and Bio Metadata Injection
      document.getElementById('dynamicBrand').innerText = data.brandName;
      document.getElementById('athleteMeta').innerHTML = `<strong>Athlete:</strong> ${data.athleteName} &nbsp;|&nbsp; <strong>Discipline/Position:</strong> ${data.position}`;

      // 3. Render Capacity Screen Cards
      const screenContainer = document.getElementById('screenList');
      screenContainer.innerHTML = '';
      data.screens.forEach(item => {
        const row = document.createElement('div');
        row.className = `screen-item ${item.status}`;
        row.innerHTML = `
          <span class="screen-name">${item.name}</span>
          <span class="screen-value">${item.value}</span>
        `;
        screenContainer.appendChild(row);
      });

      // 4. Update Load Management Panel Metrics
      document.getElementById('loadIntro').innerText = data.loadManagement.intro;
      document.getElementById('loadLabel').innerText = data.loadManagement.unitLabel;
      
      const pFill = data.loadManagement.percentage;
      const bar = document.getElementById('loadBar');
      bar.style.width = `${pFill}%`;

      const alertContainer = document.getElementById('loadAlert');
      alertContainer.innerText = data.loadManagement.alert;
      
      // Toggle alerts colors dynamically based on percentage status
      if (pFill > 85) {
        alertContainer.style.background = "rgba(239, 68, 68, 0.1)";
        alertContainer.style.borderColor = "var(--status-restricted)";
      } else if (pFill > 70) {
        alertContainer.style.background = "rgba(245, 158, 11, 0.1)";
        alertContainer.style.borderColor = "var(--status-monitor)";
      } else {
        alertContainer.style.background = "rgba(16, 185, 129, 0.1)";
        alertContainer.style.borderColor = "var(--status-optimal)";
      }

      // 5. Structure Dynamic Metric Categories Output
      document.getElementById('perfTitle').innerText = data.performance.title;
      const grid = document.getElementById('perfGrid');
      grid.innerHTML = '';

      data.performance.categories.forEach(cat => {
        const catBox = document.createElement('div');
        catBox.className = 'perf-category';
        
        let htmlContent = `<div class="category-title">${cat.name}</div>`;
        cat.metrics.forEach(m => {
          htmlContent += `
            <div class="metric-row">
              <span class="metric-label">${m.name}</span>
              <div class="metric-values">
                <span class="val-pre">${m.pre}</span>
                <span class="val-post">${m.post}</span>
              </div>
            </div>
          `;
        });
        
        catBox.innerHTML = htmlContent;
        grid.appendChild(catBox);
      });

      // 6. Refactor Bottom Dynamic Action Text
      document.getElementById('ctaHeading').innerText = data.cta.title;
      document.getElementById('ctaDesc').innerText = data.cta.desc;
    }

    // Set Initial Default Run to Baseball on Boot
    window.addEventListener('DOMContentLoaded', () => {
      switchSportProfile('baseball');
    });
  </script>
</body>
</html>
